# ==============================================================================
# Production Environment Variables for fb-inbox-worker (Template)
# Path on Ubuntu VPS: /etc/fb-inbox-worker/worker.env
# Permissions: chmod 600 /etc/fb-inbox-worker/worker.env
# Owner: fbworker:fbworker
# ==============================================================================

NODE_ENV=production

# Facebook Page ID
FB_PAGE_ID=1389294167596309

# CRM Backend Endpoints (Production HTTPS)
CRM_SYNC_ENDPOINT=https://crm.cuachongngap.com/api/inbox/browser-sync
CRM_COMPANY_ID=00000000-0000-0000-0000-000000000001

# Shared Worker Secret (Must match CRM FB_WORKER_SECRET exactly)
# Generate via: openssl rand -hex 32
FB_WORKER_SECRET=CHANGE_ME_TO_STRONG_PRODUCTION_SECRET

# Persistent Browser Profile Directory on VPS Persistent Disk
# Strictly outside code release directory to survive deployments
USER_DATA_DIR=/var/lib/fb-inbox-worker/user_data

# Headless mode for Linux VPS
HEADLESS=true

# Health Monitoring Server
HEALTH_PORT=3099
HEALTH_HOST=0.0.0.0

# Intervals (milliseconds)
POLL_INTERVAL_MS=5000
NAVIGATION_TIMEOUT_MS=45000
