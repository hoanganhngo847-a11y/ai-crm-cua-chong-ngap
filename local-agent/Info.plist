<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleIdentifier</key><string>com.local.zalo-recorder</string>
    <key>CFBundleName</key><string>Zalo Recorder</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key><string>CRM Zalo Outbound Call</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>crm-zalo</string>
            </array>
        </dict>
