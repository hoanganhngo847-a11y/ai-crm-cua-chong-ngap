{
  "name": "ai-crm-cua-chong-ngap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:staging-readiness": "tsx --conditions=react-server tests/staging/staging-readiness.test.ts",
    "test:cron-auth": "tsx --conditions=react-server tests/staging/cron-authorization.test.ts",
    "test:upload-transport": "tsx --conditions=react-server tests/staging/upload-transport-readiness.test.ts",
    "test:auth": "tsx --conditions=react-server tests/auth/auth_runtime.test.ts",
    "test:security": "tsx --conditions=react-server tests/security/trusted_server.test.ts",
    "test:p0-security": "tsx --conditions=react-server tests/security/p0_security_regression.test.ts",
    "test:p1-backend": "tsx --conditions=react-server tests/security/p1_backend_regression.test.ts",
    "test:zalo": "tsx --conditions=react-server tests/zalo/zalo_pglite.test.ts",
    "test:survey": "tsx --test features/survey/__tests__/survey.service.test.ts features/survey/__tests__/hardening.test.ts features/survey/__tests__/database.test.ts",
    "test:ai-analysis": "tsx --conditions=react-server tests/ai-analysis/ai-analysis.test.ts",
    "test:sales-style": "tsx --conditions=react-server tests/sales-style/sales-style.test.ts",
    "test:sales-style-activation": "tsx --conditions=react-server tests/sales-style/sales-style-activation.test.ts",
    "test:response-sla": "tsx --conditions=react-server tests/response-sla/evaluate-response-sla.test.ts",
    "test:response-sla-db": "tsx --conditions=react-server tests/response-sla/response-sla-db.test.ts",
    "test:analytics": "tsx --conditions=react-server tests/analytics/analytics.test.ts",
    "test:analytics-ui": "tsx --conditions=react-server tests/analytics/analytics_ui.test.ts",
    "test:response-sla-facebook": "tsx --conditions=react-server tests/response-sla/facebook-sla-runtime.test.ts",
    "test:ai-analysis-worker": "tsx --conditions=react-server tests/ai-analysis/analysis-worker.test.ts",
    "test:sales-style-runtime": "tsx --conditions=react-server tests/sales-style/runtime-style-context.test.ts",
    "test:e2e-current": "tsx --conditions=react-server tests/e2e/current-system.integration.test.ts && tsx --conditions=react-server tests/e2e/security-boundaries.test.ts",
    "test:migration-integrity": "tsx --conditions=react-server tests/e2e/migration-integrity.test.ts",
    "test:fixture-repeatability": "tsx --conditions=react-server tests/e2e/fixture-repeatability.test.ts",
    "test:integration-gate": "tsx --conditions=react-server tests/e2e/run-integration-gate.ts",
    "test:voice": "node --conditions=react-server tests/run-voice-tests.cjs",
    "test:operations": "tsx --conditions=react-server --test tests/operations/operations.test.ts tests/operations/database.test.ts",
    "test:omnichannel": "tsx --conditions=react-server --test tests/omnichannel/runtime.test.ts",
    "test:omnichannel:db": "tsx tests/omnichannel/database.test.ts",
    "test:zalo:db": "tsx --conditions=react-server tests/zalo/zalo_supabase.integration.test.ts",
    "test:crm": "npx tsx --conditions=react-server tests/crm/test_p0_fail_closed_and_zero_phone.ts && npx tsx --conditions=react-server tests/crm/test_p0_atomic_compensation.ts && npx tsx --conditions=react-server tests/crm/test_p0_urgent_tenant_isolation.ts && npx tsx --conditions=react-server tests/crm/test_p1_stage_history_tenant_isolation.ts && npx tsx --conditions=react-server tests/crm/test_p1_stage_allowlist.ts && npx tsx --conditions=react-server tests/crm/test_p1_server_authority_identity.ts",
    "test:inbox": "npx tsx --conditions=react-server tests/inbox/test_p0_inbox_tenant_isolation.ts && npx tsx --conditions=react-server tests/inbox/test_p0_zero_phone_sanitization.ts && npx tsx --conditions=react-server tests/inbox/test_p0_webhook_fail_closed.ts && npx tsx --conditions=react-server tests/inbox/test_inbox_navigation_and_rbac.ts",
    "test:inbox:db": "tsx --conditions=react-server tests/inbox/database.test.ts",
    "test:commercial": "tsx --conditions=react-server tests/commercial/pricing.test.ts && tsx --conditions=react-server tests/commercial/payment.test.ts && tsx --conditions=react-server tests/commercial/contract.test.ts",
    "test:commercial:db": "tsx --conditions=react-server tests/commercial/commercial-db.integration.test.ts",
    "test:round3-product-runtime": "tsx --conditions=react-server tests/e2e/round3-product-runtime.test.ts",
    "test:all": "npm run test:auth && npm run test:security && npm run test:crm && npm run test:inbox",
    "test": "npm run test:auth && npm run test:security && npm run test:survey"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.116.0",
    "next": "16.3.5",
    "openai": "^7.20.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
