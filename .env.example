# Public Supabase credentials for client-side and server-side user-scoped operations
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only privileged service-role key (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Zalo OA Integration (Server-only credentials)
ZALO_OA_ID=your_zalo_oa_id
ZALO_APP_ID=your_zalo_app_id
ZALO_APP_SECRET=your_zalo_app_secret
ZALO_ACCESS_TOKEN=your_zalo_access_token
ZALO_REFRESH_TOKEN=your_zalo_refresh_token
ZALO_WEBHOOK_SECRET=your_zalo_webhook_secret
