# Public Supabase credentials for client-side and server-side user-scoped operations
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only privileged service-role key (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Facebook: server-owned Page -> Company mapping. Unique page IDs are required.
# When set, this replaces the single-page META_PAGE_ID fallback.
# META_PAGE_BINDINGS=[{"page":"123456","company":"company-uuid","tokenEnv":"META_MAIN_TOKEN"}]
# META_MAIN_TOKEN=page-access-token
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=

# Website is bound to this server-owned company and origin.
OMNICHANNEL_COMPANY_ID=
WEBSITE_ORIGIN=http://localhost:3000
WEBSITE_RATE_SECRET=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
