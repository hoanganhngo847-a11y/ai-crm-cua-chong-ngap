# Public Supabase credentials for client-side and server-side user-scoped operations
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only privileged service-role key (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Zalo transport
# OA keeps the existing official Zalo OA integration. ZCAJS routes personal-account messaging
# through the separate long-running worker under /zalo-zcajs-worker.
ZALO_TRANSPORT=OA

# Zalo OA Integration
# Per-OA credentials/tokens/webhook secrets are stored in private.zalo_oa_secrets and managed via
# upsertZaloOaConnectionAction (BOSS_ADMIN + MFA). Do NOT put OA access/refresh tokens in env.
# Optional legacy fallback used only when an OA has no per-OA webhook secret configured:
ZALO_APP_ID=your_zalo_app_id
ZALO_WEBHOOK_SECRET=your_zalo_oa_secret_key

# ZCAJS bridge (server-only). Required only when ZALO_TRANSPORT=ZCAJS.
# The same random secret is configured on both the CRM web service and the ZCAJS worker.
ZALO_ZCAJS_COMPANY_ID=
ZALO_ZCAJS_WORKER_URL=
ZALO_ZCAJS_WORKER_SECRET=

# Zalo AI auto-reply kill switch (server-only).
# The durable switch is AI Control Center (ai_brain_live_settings.enabled for ZALO).
# Set this to false as an immediate emergency brake; automated Zalo replies stop
# everywhere, including the Response SLA runtime, while manual Sale replies continue.
ZALO_AI_AUTO_REPLY_ENABLED=true

# Optional. Path of the worker's durable inbound queue (defaults to data/zcajs-inbound-queue.jsonl).
# ZCAJS_INBOX_QUEUE_FILE=/var/lib/zcajs/inbound-queue.jsonl

# Payment / Bank Transfer Webhook (server-only; fail-closed HMAC signature verification)
WEBHOOK_SECRET=replace-with-a-long-random-payment-webhook-secret

# Voice / Hotline (server-only unless explicitly public)
VOICE_PROVIDER=MOCK
CRON_SECRET=replace-with-a-long-random-secret
# HMAC key for canonical PHONE identities; server-only and shared by all app instances.
PHONE_IDENTITY_HMAC_SECRET=replace-with-at-least-32-random-bytes

# Development-only legacy adapter values. Production resolves per-company env names
# from voice_provider_integrations and never uses a global default company.
VOICE_WEBHOOK_SECRET=replace-with-dev-stringee-signing-secret
STRINGEE_API_KEY=SK_your_api_key
STRINGEE_API_SECRET=your_api_secret
STRINGEE_FROM_NUMBER=8428xxxxxxx
STRINGEE_ANSWER_URL=https://your-domain.example/api/webhooks/voice/your-opaque-routing-token?projectId=your-stringee-project-id
STRINGEE_AI_AGENT_USER_ID=ai-hotline-agent
STRINGEE_SALE_AGENT_USER_ID=sale-agent
VOICE_MAX_RECORDING_BYTES=26214400
NEXT_PUBLIC_VOICE_PROVIDER=STRINGEE
OPENAI_API_KEY=your-openai-api-key
# OPENAI_TRANSCRIPTION_MODEL: Shared legacy voice model override is unchanged.
# NOTE / SHARED ENV CAVEAT: When TRANSCRIPTION_PROVIDER=OPENAI and OPENAI_TRANSCRIPTION_MODEL is unset,
# Zalo uses the timestamp-compatible validated default whisper-1.
# Existing OpenAI API requests always send verbose_json; overriding with an unsupported model
# may fail the provider request.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize

# --- Transcription Provider Selection ---
# TRANSCRIPTION_PROVIDER: OPENAI (default) or GEMINI
# When absent, defaults to OPENAI for backwards compatibility.
# Invalid values fail closed.
# TRANSCRIPTION_PROVIDER=OPENAI

# --- Gemini Transcription ---
# GEMINI_API_KEY: Required when TRANSCRIPTION_PROVIDER=GEMINI and the pool is disabled/empty.
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_TRANSCRIPTION_MODEL: Default is gemini-3.5-transcribe
# GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
# Optional multi-project pool. Keep disabled until migration and encrypted entries are ready.
# GEMINI_POOL_ENABLED=false
# Base64 encoding of exactly 32 random bytes used only for server-side AES-256-GCM encryption.
# Never expose this value to the browser and never rotate it without re-encrypting stored entries.
# GEMINI_POOL_MASTER_KEY_B64=
# Only this company may manage the global provider pool through /admin/gemini-keys.
# GEMINI_POOL_ADMIN_COMPANY_ID=

# --- Zalo Call AI Summary (Phase 2B) ---
# SUMMARY_PROVIDER: GEMINI (default) or OPENAI
# SUMMARY_PROVIDER=GEMINI
# GEMINI_SUMMARY_MODEL: Default is gemini-2.5-flash
# GEMINI_SUMMARY_MODEL=gemini-2.5-flash
# OPENAI_SUMMARY_MODEL: Default is gpt-4o-mini
# OPENAI_SUMMARY_MODEL=gpt-4o-mini
# SUMMARY_ACTIVATION_CUTOFF: ISO-8601 timestamp cutoff for automated reconciliation recovery
# SUMMARY_ACTIVATION_CUTOFF=2026-10-21T20:00:00Z

# --- Zalo cá nhân live voice (OFF by default; server-only Gemini key) ---
# ZALO_PERSONAL_LIVE_VOICE_ENABLED=0
# ZALO_PERSONAL_LIVE_VOICE_AUTO_ANSWER=0
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

OPENAI_INTAKE_MODEL=gpt-5-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
# Optional; when omitted the safe Vietnamese Hotline prompt embedded in the server is used.
# OPENAI_REALTIME_INSTRUCTIONS=

# Example tenant-scoped secrets referenced by voice_provider_integrations rows.
VOICE_ACME_STRINGEE_WEBHOOK_SECRET=replace-with-stringee-signing-secret
VOICE_ACME_STRINGEE_API_KEY=SK_your_api_key
VOICE_ACME_STRINGEE_API_SECRET=your_api_secret
VOICE_ACME_STRINGEE_FROM_NUMBER=8428xxxxxxx
VOICE_ACME_STRINGEE_ANSWER_URL=https://your-domain.example/api/webhooks/voice/your-stringee-routing-token?projectId=your-stringee-project-id
VOICE_ACME_STRINGEE_AI_AGENT_USER_ID=ai-hotline-agent
VOICE_ACME_STRINGEE_SALE_AGENT_USER_ID=sale-agent
VOICE_ACME_OPENAI_WEBHOOK_SECRET=whsec_your-openai-webhook-secret
VOICE_ACME_OPENAI_API_KEY=your-openai-api-key

# Facebook / Meta Messenger
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=
# Explicit target tenant UUID for Meta Data Deletion callback requests (fails closed 503 if missing or invalid UUID)
META_DATA_DELETION_COMPANY_ID=
# Optional Facebook Login for Business configuration ID.
META_LOGIN_CONFIG_ID=

# Temporary Meta App Review exception. Comma-separated Supabase Auth user UUIDs.
# These users still must be ACTIVE BOSS_ADMIN members and the exception applies only
# to /admin/facebook and /api/facebook/connect/*; all other admin areas still require AAL2.
# Remove this value immediately after Meta App Review.
META_REVIEWER_USER_IDS=

# Server-owned Page -> Company mapping. Unique Page IDs are required.
# When META_PAGE_BINDINGS is set, it replaces the single-page META_PAGE_ID fallback.
# Each Page references a separate server-only token env; never put access tokens inside the JSON.
# Optional `name` is used as the CRM display label and avoids a Graph lookup for the Page name.
# Example with two Pages for the same company:
# META_PAGE_BINDINGS=[{"page":"1026991374010112","company":"company-uuid","tokenEnv":"META_PAGE_CHD_TOKEN","name":"Du học Đức và Học Tiếng Đức CHD"},{"page":"123456","company":"company-uuid","tokenEnv":"META_PAGE_MAIN_TOKEN","name":"Cửa chống ngập"}]
META_PAGE_BINDINGS=
META_PAGE_CHD_TOKEN=
META_PAGE_MAIN_TOKEN=
META_PAGE_NORTH_TOKEN=
# Optional direct-Meta fallback for the Botcake-managed Page. Only needed when
# that Page is subscribed to this Meta app instead of using Pancake Webhooks.
META_PAGE_BOTCAKE_TOKEN=

# Backward-compatible single-page fallback when META_PAGE_BINDINGS is empty.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_PAGE_NAME=

# Meta Ads Integration & Marketing API
# Token encryption key for securing Ad Account access tokens at rest via AES-256-GCM.
# (If unset, falls back to META_APP_SECRET as encryption key).
META_TOKEN_ENCRYPTION_KEY=
# Meta Graph API version for Marketing and Webhook API calls (default: v21.0)
META_GRAPH_VERSION=v21.0
# Optional System User token with ads_read and leads_retrieval for background cron sync
META_SYSTEM_USER_TOKEN=

# Botcake/Pancake inbound receiver. The Page ID and company UUID are
# server-owned; never accept either authority from the webhook payload.
# Preferred transport: Pancake page Webhook (event_type=messaging).
# Legacy Botcake Flow JSON API bodies are accepted for manual tests only.
BOTCAKE_PAGE_ID=
BOTCAKE_COMPANY_ID=
BOTCAKE_WEBHOOK_SECRET=

# Website is bound to this server-owned company and origin.
OMNICHANNEL_COMPANY_ID=
WEBSITE_ORIGIN=http://localhost:3000
WEBSITE_RATE_SECRET=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Stringee Web SDK test project (server-only; DB integration references these names).
# Leave FROM_NUMBER unset to keep PSTN dispatch unavailable.
STRINGEE_API_SID=SK_test_project_sid
STRINGEE_SIGNING_SECRET=replace-with-test-project-signing-secret
# Enable the admin + MFA app-to-app diagnostic only for this configured project ID.
STRINGEE_APP_TO_APP_TEST_PROJECT_ID=
# Recording is opt-in; app-to-app diagnostics never record regardless of this flag.
VOICE_RECORDING_ENABLED=false

# AI Brain / Javis-compatible internal Brain Service
# Server-only. Shadow Mode remains disabled until ai_brain_shadow_settings is explicitly enabled.
JAVIS_BRAIN_BASE_URL=
JAVIS_BRAIN_INTERNAL_TOKEN=

# Customer 360 dossier task, independent from channel delivery. Default OFF.
# Requires an explicit customer_dossier_settings.enabled=true for each company too.
CUSTOMER_DOSSIER_ENABLED=false

# Human-authorized campaigns. All flags OFF until a separately verified channel rollout.
BULK_MESSAGING_ENABLED=false
FACEBOOK_CAMPAIGNS_ENABLED=false
ZALO_OA_CAMPAIGNS_ENABLED=false
# Set a separate random >=32-character secret only when installing the targeted worker.
CAMPAIGN_CRON_SECRET=
