# Public Supabase credentials for client-side and server-side user-scoped operations
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only privileged service-role key (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Voice / Hotline (server-only unless explicitly public)
VOICE_PROVIDER=MOCK
CRON_SECRET=replace-with-a-long-random-secret
# HMAC key for canonical PHONE identities; server-only and shared by all app instances.
PHONE_IDENTITY_HMAC_SECRET=replace-with-at-least-32-random-bytes

# Development-only legacy adapter values. Production resolves per-company env names
# from voice_provider_integrations and never uses a global default company.
VOICE_WEBHOOK_SECRET=replace-with-dev-stringee-signing-secret
STRINGEE_API_KEY=SK_your_api_key
STRINGEE_API_SECRET=your_api_secret
STRINGEE_FROM_NUMBER=8428xxxxxxx
STRINGEE_ANSWER_URL=https://your-domain.example/api/webhooks/voice/your-opaque-routing-token?projectId=your-stringee-project-id
STRINGEE_AI_AGENT_USER_ID=ai-hotline-agent
STRINGEE_SALE_AGENT_USER_ID=sale-agent
VOICE_MAX_RECORDING_BYTES=26214400
NEXT_PUBLIC_VOICE_PROVIDER=STRINGEE
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
OPENAI_INTAKE_MODEL=gpt-5-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
# Optional; when omitted the safe Vietnamese Hotline prompt embedded in the server is used.
# OPENAI_REALTIME_INSTRUCTIONS=

# Example tenant-scoped secrets referenced by voice_provider_integrations rows.
VOICE_ACME_STRINGEE_WEBHOOK_SECRET=replace-with-stringee-signing-secret
VOICE_ACME_STRINGEE_API_KEY=SK_your_api_key
VOICE_ACME_STRINGEE_API_SECRET=your_api_secret
VOICE_ACME_STRINGEE_FROM_NUMBER=8428xxxxxxx
VOICE_ACME_STRINGEE_ANSWER_URL=https://your-domain.example/api/webhooks/voice/your-stringee-routing-token?projectId=your-stringee-project-id
VOICE_ACME_STRINGEE_AI_AGENT_USER_ID=ai-hotline-agent
VOICE_ACME_STRINGEE_SALE_AGENT_USER_ID=sale-agent
VOICE_ACME_OPENAI_WEBHOOK_SECRET=whsec_your-openai-webhook-secret
VOICE_ACME_OPENAI_API_KEY=your-openai-api-key
