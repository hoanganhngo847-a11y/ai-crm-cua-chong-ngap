# Public Supabase credentials for client-side and server-side user-scoped operations
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only privileged service-role key (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Zalo OA Integration
# Per-OA credentials/tokens/webhook secrets are stored in private.zalo_oa_secrets and managed via
# upsertZaloOaConnectionAction (BOSS_ADMIN + MFA). Do NOT put OA access/refresh tokens in env.
# Optional legacy fallback used only when an OA has no per-OA webhook secret configured:
ZALO_APP_ID=your_zalo_app_id
ZALO_WEBHOOK_SECRET=your_zalo_oa_secret_key

# Payment / Bank Transfer Webhook (server-only; fail-closed HMAC signature verification)
WEBHOOK_SECRET=replace-with-a-long-random-payment-webhook-secret

# Voice / Hotline (server-only unless explicitly public)
VOICE_PROVIDER=MOCK
CRON_SECRET=replace-with-a-long-random-secret
# HMAC key for canonical PHONE identities; server-only and shared by all app instances.
PHONE_IDENTITY_HMAC_SECRET=replace-with-at-least-32-random-bytes

# Development-only legacy adapter values. Production resolves per-company env names
# from voice_provider_integrations and never uses a global default company.
VOICE_WEBHOOK_SECRET=replace-with-dev-stringee-signing-secret
STRINGEE_API_KEY=SK_your_api_key
STRINGEE_API_SECRET=your_api_secret
STRINGEE_FROM_NUMBER=8428xxxxxxx
STRINGEE_ANSWER_URL=https://your-domain.example/api/webhooks/voice/your-opaque-routing-token?projectId=your-stringee-project-id
STRINGEE_AI_AGENT_USER_ID=ai-hotline-agent
STRINGEE_SALE_AGENT_USER_ID=sale-agent
VOICE_MAX_RECORDING_BYTES=26214400
NEXT_PUBLIC_VOICE_PROVIDER=STRINGEE
OPENAI_API_KEY=your-openai-api-key
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
OPENAI_INTAKE_MODEL=gpt-5-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
# Optional; when omitted the safe Vietnamese Hotline prompt embedded in the server is used.
# OPENAI_REALTIME_INSTRUCTIONS=

# Example tenant-scoped secrets referenced by voice_provider_integrations rows.
VOICE_ACME_STRINGEE_WEBHOOK_SECRET=replace-with-stringee-signing-secret
VOICE_ACME_STRINGEE_API_KEY=SK_your_api_key
VOICE_ACME_STRINGEE_API_SECRET=your_api_secret
VOICE_ACME_STRINGEE_FROM_NUMBER=8428xxxxxxx
VOICE_ACME_STRINGEE_ANSWER_URL=https://your-domain.example/api/webhooks/voice/your-stringee-routing-token?projectId=your-stringee-project-id
VOICE_ACME_STRINGEE_AI_AGENT_USER_ID=ai-hotline-agent
VOICE_ACME_STRINGEE_SALE_AGENT_USER_ID=sale-agent
VOICE_ACME_OPENAI_WEBHOOK_SECRET=whsec_your-openai-webhook-secret
VOICE_ACME_OPENAI_API_KEY=your-openai-api-key

# Facebook / Meta Messenger
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=
# Optional Facebook Login for Business configuration ID.
META_LOGIN_CONFIG_ID=

# Temporary Meta App Review exception. Comma-separated Supabase Auth user UUIDs.
# These users still must be ACTIVE BOSS_ADMIN members and the exception applies only
# to /admin/facebook and /api/facebook/connect/*; all other admin areas still require AAL2.
# Remove this value immediately after Meta App Review.
META_REVIEWER_USER_IDS=

# Server-owned Page -> Company mapping. Unique Page IDs are required.
# When META_PAGE_BINDINGS is set, it replaces the single-page META_PAGE_ID fallback.
# Each Page references a separate server-only token env; never put access tokens inside the JSON.
# Optional `name` is used as the CRM display label and avoids a Graph lookup for the Page name.
# Example with two Pages for the same company:
# META_PAGE_BINDINGS=[{"page":"123456","company":"company-uuid","tokenEnv":"META_PAGE_MAIN_TOKEN","name":"Cửa chống ngập"},{"page":"789012","company":"company-uuid","tokenEnv":"META_PAGE_NORTH_TOKEN","name":"Đại lý miền Bắc"}]
META_PAGE_BINDINGS=
META_PAGE_MAIN_TOKEN=
META_PAGE_NORTH_TOKEN=

# Backward-compatible single-page fallback when META_PAGE_BINDINGS is empty.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_PAGE_NAME=

# Website is bound to this server-owned company and origin.
OMNICHANNEL_COMPANY_ID=
WEBSITE_ORIGIN=http://localhost:3000
WEBSITE_RATE_SECRET=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
