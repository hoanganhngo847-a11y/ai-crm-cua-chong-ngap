{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.crm.internal/crm-offsite-bundle-index/v1.json",
  "title": "CrmOffsiteBundleIndexV1",
  "description": "Normative wire schema for closeout/offsite-bundle-index.json in Meta Ads Staging Backup & Recovery",
  "type": "object",
  "required": [
    "format",
    "backupId",
    "projectRef",
    "createdAt",
    "destination",
    "artifacts",
    "storageRecordProof",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "type": "string",
      "const": "crm-offsite-bundle-index/v1"
    },
    "backupId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "maxLength": 256
    },
    "projectRef": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$",
      "maxLength": 64
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "destination": {
      "type": "object",
      "required": ["provider", "destinationId", "bucket", "prefix"],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["aws-s3", "gcs", "azure-blob", "supabase-storage", "s3-compatible"]
        },
        "destinationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "bucket": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "prefix": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind",
          "ciphertextSha256",
          "ciphertextBytes",
          "remote"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]+$",
            "maxLength": 1024
          },
          "kind": {
            "type": "string",
            "enum": [
              "encrypted_artifact",
              "manifest_envelope",
              "checksum_file",
              "closeout_envelope"
            ]
          },
          "ciphertextSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "ciphertextBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 70368744177632
          },
          "nonceHex": {
            "type": "string",
            "pattern": "^[0-9a-f]{24}$"
          },
          "remote": {
            "type": "object",
            "required": ["objectKey", "immutableVersionId", "retentionUntil"],
            "additionalProperties": false,
            "properties": {
              "objectKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "immutableVersionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "retentionUntil": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "encrypted_artifact",
                    "manifest_envelope",
                    "closeout_envelope"
                  ]
                }
              }
            },
            "then": {
              "required": ["nonceHex"]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "checksum_file"
                }
              }
            },
            "then": {
              "not": {
                "required": ["nonceHex"]
              }
            }
          }
        ]
      }
    },
    "storageRecordProof": {
      "type": "object",
      "required": ["proofBytesBase64", "proofSha256"],
      "additionalProperties": false,
      "properties": {
        "proofBytesBase64": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "proofSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "totalArtifacts",
        "encryptedArtifactCount",
        "totalCiphertextBytes"
      ],
      "additionalProperties": false,
      "properties": {
        "totalArtifacts": {
          "type": "integer",
          "minimum": 1
        },
        "encryptedArtifactCount": {
          "type": "integer",
          "minimum": 1
        },
        "totalCiphertextBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
