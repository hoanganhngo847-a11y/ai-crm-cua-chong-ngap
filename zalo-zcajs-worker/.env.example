# ZCAJS worker only. Never commit real values.
ZCAJS_COMPANY_ID=
ZCAJS_CRM_BASE_URL=https://your-crm.example
ZCAJS_WORKER_SECRET=

# Personal Zalo Web session values used by ngogiaphat/ZCAJS.
# Set these directly in the deployment environment; do not paste them into source control.
ZCAJS_COOKIE=
ZCAJS_IMEI=
ZCAJS_USER_AGENT=

PORT=10000

# Optional. Durable inbound queue used to replay customer messages after a
# worker/CRM restart. Defaults to data/zcajs-inbound-queue.jsonl.
# ZCAJS_INBOX_QUEUE_FILE=/app/data/zcajs-inbound-queue.jsonl
