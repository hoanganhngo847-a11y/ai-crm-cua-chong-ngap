# ZCAJS worker only. Never commit real values.
ZCAJS_COMPANY_ID=
ZCAJS_CRM_BASE_URL=https://your-crm.example
ZCAJS_WORKER_SECRET=

# Personal Zalo Web session values used by ngogiaphat/ZCAJS.
